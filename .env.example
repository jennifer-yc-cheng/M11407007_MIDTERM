# 複製成 .env 後修改（cp .env.example .env）。沒有 .env 也能用預設值啟動。
HTTP_PORT=80

POSTGRES_USER=drink
POSTGRES_PASSWORD=drink123

# 請改成隨機長字串（例如：openssl rand -hex 32）
JWT_SECRET=please-change-this-jwt-secret
INTERNAL_TOKEN=please-change-this-internal-token

# 首次啟動時建立的帳號密碼
ADMIN_PASSWORD=admin123
DEFAULT_MANAGER_PASSWORD=manager123
